NODE_ENV=development
PORT=4000

DATABASE_URL=postgresql://cali:cali_password@localhost:5432/calibet_platform?schema=public
REDIS_URL=redis://localhost:6379

JWT_SECRET=replace_with_long_random_secret
JWT_EXPIRES_IN=1d

EXTERNAL_BASE_URL=https://www.calibet.com/
EXTERNAL_LOGIN_PATH=/

WORKER_INTERNAL_URL=http://localhost:4300
WORKER_SHARED_KEY=replace_with_worker_shared_key
VIEW_TOKEN_SECRET=replace_with_view_token_secret
BRIDGE_TOKEN_TTL_SECONDS=900

LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=replace_with_livekit_api_key
LIVEKIT_API_SECRET=replace_with_livekit_api_secret
LIVEKIT_TOKEN_TTL_SECONDS=900
LIVEKIT_INGRESS_INPUT=RTMP
